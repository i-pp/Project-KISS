# Project-KISS Coding Standard v1.0
# Conservative normalization, not the complete set of policy-permitted forms.
# None disables formatting unless DisableFormat is explicitly reset.
BasedOnStyle: None
DisableFormat: false
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: Never
  BeforeElse: false
  BeforeWhile: false
IndentCaseLabels: false
IndentAccessModifiers: false
PointerAlignment: Left
ReferenceAlignment: Left
SpaceBeforeParens: ControlStatements
SpacesInParentheses: false
SpacesInSquareBrackets: false
AllowShortFunctionsOnASingleLine: None
# Do not join a multiline ternary body to its control statement.
# Simple single-line controls remain policy-permitted; this formatter expands them.
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
AlignOperands: Align
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
BinPackArguments: false
BinPackParameters: false
Cpp11BracedListStyle: true
FixNamespaceComments: true
ReflowComments: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
